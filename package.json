{
  "name": "revira",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:all": "pnpm run test && pnpm run test:db",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:check": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-infra.mts",
    "db:migrate": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts",
    "db:seed": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "worker": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/worker.mts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run check:i18n && pnpm run knip && pnpm run test",
    "verify": "pnpm run check && pnpm run test:db && pnpm run build",
    "ai:smoke": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-smoke.mts",
    "ai:analyze": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-analyze.mts",
    "ai:eval": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-eval.mts",
    "golive": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/golive.mts",
    "ai:redteam": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-redteam.mts",
    "knip": "knip --include files,dependencies,unlisted,duplicates",
    "knip:all": "knip",
    "check:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n.mts",
    "test:e2e": "playwright test",
    "test:e2e:clean": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-clean.mts",
    "mock:platform": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-platform.mts",
    "mock:inbound": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-inbound.mts",
    "mock:billing": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-billing.mts",
    "email:preview": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/email-preview.mts",
    "reviews:rescore": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reviews-rescore.mts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "better-auth": "^1.6.25",
    "bullmq": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.31.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
