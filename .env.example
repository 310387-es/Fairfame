# Fairfame — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# Every variable here is validated at startup by src/lib/env.ts (Zod).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Datastores — match the services in docker-compose.yml
# ---------------------------------------------------------------------------
# Owner/migration connection. Superuser: runs migrations and seeds, and is NOT
# subject to Row-Level Security. Never use it to serve a request.
DATABASE_URL=postgres://fairfame:fairfame@localhost:5432/fairfame

# Runtime connection. Non-superuser, NOBYPASSRLS — every tenant query the app
# makes goes through this role so RLS policies actually apply.
APP_DATABASE_URL=postgres://fairfame_app:fairfame_app@localhost:5432/fairfame

# Credentials for the app role, consumed by docker-compose's init script.
# Must agree with APP_DATABASE_URL above.
APP_DB_USER=fairfame_app
APP_DB_PASSWORD=fairfame_app

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (BetterAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# How often the worker scans for connections to sync (milliseconds).
SYNC_SCAN_INTERVAL_MS=60000

# İYS (Türkiye commercial-message registry) applies here. Only set false
# outside Türkiye — local consent is still required either way.
IYS_REQUIRED=true
# `none` refuses every commercial send. `local` trusts our own consent
# records — development only; it refuses in production.
IYS_GATEWAY=none

# WhatsApp Cloud API (P1b-T3). Blank until the WhatsApp Business Account,
# verified number and approved templates exist — sends refuse until then.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Instagram webhook (P1b-T4). The signature check reuses META_APP_SECRET.
INSTAGRAM_VERIFY_TOKEN=
# `none` refuses every SMS. `mock` accepts without contacting anyone, and
# records that it did — see `isRealSmsGateway`, whose allowlist is empty until
# a real BSP adapter exists.
SMS_GATEWAY=none

ANALYZE_SWEEP_INTERVAL_MS=300000
NOTIFY_SWEEP_INTERVAL_MS=120000
DIGEST_SWEEP_INTERVAL_MS=3600000
SLA_SWEEP_INTERVAL_MS=300000
REPORT_SWEEP_INTERVAL_MS=3600000
BROADCAST_SWEEP_INTERVAL_MS=60000
IYS_SWEEP_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# First-party collection (P1b-T1)
# ---------------------------------------------------------------------------
# Public origin for review-request short links and QR codes. Defaults to
# BETTER_AUTH_URL when unset; set it explicitly once collection pages live on
# their own hostname.
APP_URL=http://localhost:3000

# log | smtp. `log` renders the email and logs it without sending — the safe
# default. `smtp` sends to SMTP_URL; locally that is the Mailpit container,
# whose inbox is at http://localhost:8025.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Fairfame <no-reply@fairfame.local>

# Abuse guard on the public submission endpoint: submissions per IP, per
# campaign, per window.
PUBLIC_SUBMIT_LIMIT=5
PUBLIC_SUBMIT_WINDOW_SECONDS=600
# The same guard on a public survey response, which is a separate endpoint.
PUBLIC_SURVEY_LIMIT=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal — defaults to debug outside production
LOG_LEVEL=debug
# Human-readable dev logs via pino-pretty. Set to false for raw JSON.
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Billing — skeleton only in Phase 0; no live checkout on either provider.
# Leave blank to run without billing. Providers are selected by currency:
# Stripe handles USD/EUR, iyzico handles TRY (needed for e-fatura in Türkiye).
# ---------------------------------------------------------------------------
# Stripe — international billing (USD/EUR). Checkout is wired (W1.8); what is
# gated is having credentials. The webhook secret is minted per endpoint in the
# Stripe dashboard and is a *different* secret from the API key: without it the
# webhook refuses every delivery, which is correct — an unverified billing
# webhook is a way for anyone who knows the URL to grant themselves a plan.
#   Endpoint: {BETTER_AUTH_URL}/api/webhooks/stripe
#   Events:   customer.subscription.created, .updated, .deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# ---------------------------------------------------------------------------
# Connector infrastructure (P1b-T0)
# ---------------------------------------------------------------------------
# Key-encryption keys for the OAuth token vault, newest first. Without one, no
# provider may go live — there would be nowhere safe to keep its tokens.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating means prepending a new key and leaving the old one for reads:
#   TOKEN_VAULT_KEYS=k2:<new base64>,k1:<old base64>
TOKEN_VAULT_KEYS=

# ---------------------------------------------------------------------------
# Error reporting (Sentry)
# ---------------------------------------------------------------------------
# Absent is the ordinary state in development and in CI, and absent means off:
# an empty DSN makes every Sentry.init a no-op. Leave it blank locally unless
# you are specifically testing the reporting itself — otherwise a shared project
# fills with errors from six developers' half-finished branches and the one that
# came from a customer is the one nobody spots.
#
# Not a secret: it ships inside the client bundle by design and can only write
# events into the project. NEXT_PUBLIC_ because the browser needs it, which also
# means Next inlines it at BUILD time — a deployment that injects env at
# container start must set it for the build step too, or the server reports and
# the browser stays silent.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during `pnpm build`. This one IS a secret — it can write to
# the Sentry org. Build environment only; never needed at runtime, and never in
# CI, which builds only to prove the build compiles and then throws it away.
SENTRY_AUTH_TOKEN=
# Fraction of requests traced, 0..1. Defaults to 1 in development and 0.1 in
# production — raise it temporarily while chasing something specific.
SENTRY_TRACES_SAMPLE_RATE=
# Which deployment this is. Defaults to NODE_ENV, which is right locally
# (development) and in CI (test). Set it explicitly on staging: staging builds
# with NODE_ENV=production, so without this its errors are indistinguishable
# from a real customer's — including to whatever alert wakes somebody up.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Web Push (W5-9)
# ---------------------------------------------------------------------------
# Generate once per deployment:  npx web-push generate-vapid-keys
# Absent is the ordinary state: with no key pair the settings card says push is
# not configured here, and email carries on unchanged.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push service is entitled to have for the *application* — a
# mailto: or an https URL. Defaults to this deployment's own origin.
VAPID_SUBJECT=

# Per-provider mode: mock | real | off. Everything stays on `mock` until its
# credentials and platform approvals exist; `real` without credentials or a
# vault silently falls back to mock rather than breaking the connect flow.
CONNECTOR_GOOGLE_MODE=mock
CONNECTOR_INSTAGRAM_MODE=mock
CONNECTOR_WHATSAPP_MODE=mock
CONNECTOR_FIXTURE_MODE=mock

# Platform credentials — set at go-live, post company formation.
# Redirect URI to register: {APP_URL}/api/connect/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Google" on the sign-in and sign-up screens (P5-T1).
#
# NOT the same client as GOOGLE_CLIENT_ID above, and the `_AUTH_` infix exists
# so the two cannot be pasted into each other's slot. That pair is the Business
# Profile *connector* — it asks a business owner for access to their listings,
# and its consent screen has to clear Google's app review. This pair is login
# only: `openid email profile`, which needs no verification and works for
# anyone the moment the client exists.
#
# Two OAuth clients on purpose. One client doing both would tie the front door
# to a review queue — a connector scope added later would put the whole app
# back into verification, and until it cleared, nobody could sign in.
#
# Absent is the ordinary state: the button does not render and email/password
# carries the product. It is never a runtime error.
#
# Google Cloud console → APIs & Services → Credentials → OAuth client ID → Web
# application.
#
# The authorized redirect URI is **BETTER_AUTH_URL + /api/auth/callback/google**
# — one per environment, and you register the real string, never the variable
# name. With the default BETTER_AUTH_URL above that is exactly:
#
#   http://localhost:3000/api/auth/callback/google
#
# and once this is deployed, add a second one alongside it:
#
#   https://your-domain/api/auth/callback/google
#
# Google matches this string byte for byte — a trailing slash, http vs https, or
# a different host is `redirect_uri_mismatch` and nothing else. It is derived
# from `BETTER_AUTH_URL`, so changing that variable means adding the new URI in
# the console before the next deploy, not after.
#
# Consent screen: `openid`, `email`, `profile` only. All three are non-sensitive,
# so this client needs no Google app verification — which is the entire reason
# it is separate from GOOGLE_CLIENT_ID above.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# One Meta app covers both Instagram and WhatsApp.
META_APP_ID=
META_APP_SECRET=

# Where these APIs live. Blank in every real deployment — the clients default
# to Google's and Meta's own hosts, which is the only correct answer for a
# customer. `pnpm mock:platform` prints exactly these lines for its fake
# Google and fake Meta, so T2/T3/T4 can be exercised end to end with no
# credentials at all. Set the three Google ones together or not at all: a
# half-redirected connector reads locations from a fake and reviews from the
# real API, which fails in a way that looks like a bug in the connector.
GOOGLE_ACCOUNT_MANAGEMENT_BASE_URL=
GOOGLE_BUSINESS_INFORMATION_BASE_URL=
GOOGLE_REVIEWS_BASE_URL=
# One Graph API, so one variable — Instagram and WhatsApp both read it.
META_GRAPH_BASE_URL=

# ---------------------------------------------------------------------------
# AI layer (P1a-T1)
# ---------------------------------------------------------------------------
# stub | gemini | anthropic | openai-compatible. `stub` is offline and
# deterministic — the default, so nothing spends money by accident.
AI_PROVIDER=gemini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Google Gemini — development provider (free tier, no card required).
# Get a key at https://aistudio.google.com/apikey and check there which models
# your key can reach: free-tier membership changes, and the 2.5 generation
# retires in October 2026.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Overridable so a test or a proxy can stand in for the provider. Defaults to
# the real host; leave blank unless you are pointing somewhere deliberately.
GEMINI_BASE_URL=

# Anthropic — production path. Pay-as-you-go; a Claude subscription does NOT
# include API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=

# Any host speaking OpenAI's chat-completions dialect — Cerebras, Groq, Mistral,
# OpenRouter, a local Ollama. One provider file, many vendors: switching host is
# these three lines and nothing else. Useful when Gemini's per-day free tier
# runs out mid-afternoon.
#   https://api.cerebras.ai/v1   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1   http://localhost:11434/v1
# The version segment is part of the URL, and no default is supplied for any of
# the three — pick a host deliberately or leave the provider unselected.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Per-task model overrides. Blank uses the provider's default model above.
#
# Analysis runs on every review and can live on the cheapest tier. A drafted
# reply is published under the business's name, so it gets a stronger model —
# the lite tier emitted Cyrillic characters mid-word in a Turkish draft once.
# Measured on a Turkish reply prompt: 3.5-flash-lite 1.3s, 3.5-flash 4.4s,
# 3.6-flash 9.1s. 4.4s is what a button click can absorb; 9.1s is not.
#
# The digest gets the *strongest* model, and blank was the wrong default (W1.6).
# It is the product's hero feature, it runs once a week per location rather than
# on every review or every button press, and it is the one output nobody is
# waiting on — so the 9.1s that disqualifies 3.6-flash for a reply is free here.
# Left blank it fell through to the cheapest tier in the product, which is how a
# weekly briefing came to read as filler.
AI_MODEL_ANALYZE=
AI_MODEL_DRAFT_REPLY=gemini-3.5-flash
AI_MODEL_DIGEST=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Free-tier pacing: stay under the published requests-per-minute ceiling.
AI_REQUESTS_PER_MINUTE=12
AI_BATCH_CONCURRENCY=3

COMPETITOR_SOURCE=none

# Offer the development connectors ("Mock source", "Fixture provider") on
# /locations and /connections, and only alongside ?dev=1. A real deployment
# leaves this unset. It exists because `next start` reports NODE_ENV=production
# everywhere — including CI — so NODE_ENV could not tell a built app apart from
# a customer's. See src/lib/env.ts.
ALLOW_DEV_CONNECTORS=true
