# Revira — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# Every variable here is validated at startup by src/lib/env.ts (Zod).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Datastores — match the services in docker-compose.yml
# ---------------------------------------------------------------------------
# Owner/migration connection. Superuser: runs migrations and seeds, and is NOT
# subject to Row-Level Security. Never use it to serve a request.
DATABASE_URL=postgres://revira:revira@localhost:5432/revira

# Runtime connection. Non-superuser, NOBYPASSRLS — every tenant query the app
# makes goes through this role so RLS policies actually apply.
APP_DATABASE_URL=postgres://revira_app:revira_app@localhost:5432/revira

# Credentials for the app role, consumed by docker-compose's init script.
# Must agree with APP_DATABASE_URL above.
APP_DB_USER=revira_app
APP_DB_PASSWORD=revira_app

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (BetterAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# How often the worker scans for connections to sync (milliseconds).
SYNC_SCAN_INTERVAL_MS=60000

# İYS (Türkiye commercial-message registry) applies here. Only set false
# outside Türkiye — local consent is still required either way.
IYS_REQUIRED=true
# `none` refuses every commercial send. `local` trusts our own consent
# records — development only; it refuses in production.
IYS_GATEWAY=none

# WhatsApp Cloud API (P1b-T3). Blank until the WhatsApp Business Account,
# verified number and approved templates exist — sends refuse until then.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Instagram webhook (P1b-T4). The signature check reuses META_APP_SECRET.
INSTAGRAM_VERIFY_TOKEN=
ANALYZE_SWEEP_INTERVAL_MS=300000
NOTIFY_SWEEP_INTERVAL_MS=120000
DIGEST_SWEEP_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# First-party collection (P1b-T1)
# ---------------------------------------------------------------------------
# Public origin for review-request short links and QR codes. Defaults to
# BETTER_AUTH_URL when unset; set it explicitly once collection pages live on
# their own hostname.
APP_URL=http://localhost:3000

# log | smtp. `log` renders the email and logs it without sending — the safe
# default. `smtp` sends to SMTP_URL; locally that is the Mailpit container,
# whose inbox is at http://localhost:8025.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Revira <no-reply@revira.local>

# Abuse guard on the public submission endpoint: submissions per IP, per
# campaign, per window.
PUBLIC_SUBMIT_LIMIT=5
PUBLIC_SUBMIT_WINDOW_SECONDS=600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal — defaults to debug outside production
LOG_LEVEL=debug
# Human-readable dev logs via pino-pretty. Set to false for raw JSON.
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Billing — skeleton only in Phase 0; no live checkout on either provider.
# Leave blank to run without billing. Providers are selected by currency:
# Stripe handles USD/EUR, iyzico handles TRY (needed for e-fatura in Türkiye).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# ---------------------------------------------------------------------------
# Connector infrastructure (P1b-T0)
# ---------------------------------------------------------------------------
# Key-encryption keys for the OAuth token vault, newest first. Without one, no
# provider may go live — there would be nowhere safe to keep its tokens.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating means prepending a new key and leaving the old one for reads:
#   TOKEN_VAULT_KEYS=k2:<new base64>,k1:<old base64>
TOKEN_VAULT_KEYS=

# Per-provider mode: mock | real | off. Everything stays on `mock` until its
# credentials and platform approvals exist; `real` without credentials or a
# vault silently falls back to mock rather than breaking the connect flow.
CONNECTOR_GOOGLE_MODE=mock
CONNECTOR_INSTAGRAM_MODE=mock
CONNECTOR_WHATSAPP_MODE=mock
CONNECTOR_FIXTURE_MODE=mock

# Platform credentials — set at go-live, post company formation.
# Redirect URI to register: {APP_URL}/api/connect/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One Meta app covers both Instagram and WhatsApp.
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# AI layer (P1a-T1)
# ---------------------------------------------------------------------------
# stub | gemini | anthropic. `stub` is offline and deterministic — the default,
# so nothing spends money by accident.
AI_PROVIDER=gemini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Google Gemini — development provider (free tier, no card required).
# Get a key at https://aistudio.google.com/apikey and check there which models
# your key can reach: free-tier membership changes, and the 2.5 generation
# retires in October 2026.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic — production path. Pay-as-you-go; a Claude subscription does NOT
# include API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Per-task model overrides. Blank uses the provider's default model above.
# Analysis runs on every review and can live on the cheapest tier; a drafted
# reply is published under the business's name, so it gets a stronger model —
# the lite tier emitted Cyrillic characters mid-word in a Turkish draft once.
# Measured on a Turkish reply prompt: 3.5-flash-lite 1.3s, 3.5-flash 4.4s,
# 3.6-flash 9.1s. 4.4s is what a button click can absorb; 9.1s is not.
AI_MODEL_ANALYZE=
AI_MODEL_DRAFT_REPLY=gemini-3.5-flash
AI_MODEL_DIGEST=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Free-tier pacing: stay under the published requests-per-minute ceiling.
AI_REQUESTS_PER_MINUTE=12
AI_BATCH_CONCURRENCY=3

COMPETITOR_SOURCE=none
